# Dataset — provided by KLA, not redistributed in the repo.
# Kept locally; scripts reference these paths at runtime.
#   data/train/{GT,NoisyLR}/   training pairs
#   data/val/{GT,NoisyLR}/     validation split (created by scripts/make_split.py)
#   data/sample/{GT,NoisyLR}/  inspection samples
#   data/NoisyLR/              held-out test inputs
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS
.DS_Store

# Inference timing is regenerated on every run
results/inference_timing.json

# Intermediate render artifacts (regenerated by scripts/make_*.py)
results/demo_frames/
results/prototype_preview/

# Videos are distributed via the submission link, not the repo.
# Regenerate with scripts/make_demo_video.py + scripts/add_narration.py
results/*.mp4
